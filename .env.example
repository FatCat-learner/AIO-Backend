# 复制成本地配置：cp .env.example .env（.env 已被 git 忽略，不要提交）
# 所有项都有默认值，本文件只是把可调项列全，按需打开

# 运行环境：dev / test / prod。只有写 prod 才启用生产校验
ENV=dev
# SQL 回显与调试输出；prod 下务必设 false
DEBUG=true

APP_NAME=AIO Demo

# 默认 SQLite；切 PostgreSQL 时改成
# postgresql+asyncpg://aio:pass@localhost:5432/aio
DATABASE_URL=sqlite+aiosqlite:///./aio_demo.db
ENABLE_VECTOR=false

# /mcp 调试台（streamable-http）：无鉴权、可执行任意 SQL，默认关闭。
# 只想用 DSH 的 MCP 工具不用开它——DSH 走 scripts/mcp_stdio.py（stdio）
MCP_ENABLED=false

# JWT 签名密钥：prod 下少于 32 字节或还是出厂默认值会拒绝启动
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 开发便利账号：每次启动保证该账号可登录。线上必须设 false
DEV_SEED_ADMIN=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=12345

# 允许跨域的前端来源，逗号分隔（H5 dev 常用 5173 / 9527 / 9528）
CORS_ORIGINS=http://localhost:5173,http://localhost:9527,http://localhost:9528,http://127.0.0.1:5173,http://127.0.0.1:9527,http://127.0.0.1:9528
